#!/bin/bash
# One low-resolution frame of the phone's screen, for the live preview in the
# panel. Not a video: a still, cheap enough to repeat every second or so.
#
#   dori-frame [--slot a|b] [--out PATH] [--width 320]
#
# Exit codes: 0 wrote a frame, 1 no phone or the grab failed, 2 the phone's
# screen is off, so there is nothing worth fetching.
#
# --slot writes $XDG_RUNTIME_DIR/dori/frame-<slot>.png and prints the path. A
# caller that alternates slots always hands its image loader a URL it has not
# cached, which is how the panel gets a moving picture out of still frames.
#
# A grab that takes too long is abandoned rather than waited on.
#
# The frame is written atomically, so a panel reading the file never catches it
# half-written, and a grab that comes back empty leaves the previous frame in
# place rather than blanking the preview. Frames live in $XDG_RUNTIME_DIR: user
# only, in memory, gone at logout.

set -uo pipefail

OUT="${XDG_RUNTIME_DIR:-/tmp}/dori/frame.png"
WIDTH=320

while (($# > 0)); do
  case "$1" in
    --out) OUT="${2:-$OUT}"; shift 2 ;;
    --slot) OUT="${XDG_RUNTIME_DIR:-/tmp}/dori/frame-${2:-a}.png"; shift 2 ;;
    --width) WIDTH="${2:-320}"; shift 2 ;;
    -h | --help)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    *)
      echo "dori-frame: unknown argument $1" >&2
      exit 1
      ;;
  esac
done

# With the cable in and Wi-Fi on at the same time, adb sees two devices and
# every bare adb call fails with "more than one device". Always name one, and
# prefer the cable: it is the faster transport and the one just plugged in.
dori_serial() {
  [[ -n ${DORI_SERIAL:-} ]] && { echo "$DORI_SERIAL"; return 0; }
  adb devices 2>/dev/null | awk '
    NR > 1 && $2 == "device" {
      if ($1 !~ /:/) { print $1; found = 1; exit }
      if (!wireless) wireless = $1
    }
    END { if (!found && wireless) print wireless }'
}

SERIAL=$(dori_serial)
[[ -n $SERIAL ]] || exit 1

# Android throttles Wi-Fi hard while the screen is off, which turns a one
# megabyte grab into a thirty second one — for a picture of a screen that is not
# showing anything. Ask first: the question costs a few bytes, the answer saves
# the transfer. If the phone will not say, assume the screen is on, because a
# slow preview beats no preview.
screen_on() {
  local answer
  answer=$(timeout 3 adb -s "$SERIAL" shell dumpsys deviceidle get screen 2>/dev/null | tr -d '\r\n')
  [[ $answer == "true" ]] && return 0
  [[ $answer == "false" ]] && return 1

  answer=$(timeout 3 adb -s "$SERIAL" shell dumpsys power 2>/dev/null |
    grep -m1 -oE 'Display Power: state=[A-Z]+')
  [[ $answer == *OFF* ]] && return 1
  return 0
}

screen_on || exit 2

mkdir -p "$(dirname "$OUT")"
tmp="$OUT.part"

# With the phone's screen off, Android throttles Wi-Fi and a one-megabyte grab
# can take half a minute. Give up early instead: the panel keeps the frame it
# already has, which is a better answer than a stalled process.
timeout 8 adb -s "$SERIAL" exec-out screencap -p >"$tmp" 2>/dev/null
# A phone mid-unlock, mid-rotation, or busy answers with nothing at all.
if [[ ! -s $tmp ]]; then
  rm -f "$tmp"
  exit 1
fi

if command -v magick >/dev/null 2>&1; then
  if magick "$tmp" -resize "${WIDTH}x" -strip "$tmp.small" 2>/dev/null; then
    mv -f "$tmp.small" "$tmp"
  fi
fi

mv -f "$tmp" "$OUT"
echo "$OUT"
