#!/bin/bash
# Take a screenshot of the phone and put it on this machine — saved to disk and
# copied to the clipboard, because the reason you took it is usually to paste it
# somewhere.
#
#   dori-shot [--dir ~/Pictures/dori] [--no-clipboard]

set -uo pipefail

DIR="${DORI_SHOT_DIR:-$HOME/Pictures/dori}"
CLIPBOARD=1

while (($# > 0)); do
  case "$1" in
    --dir) DIR="${2:-$DIR}"; shift 2 ;;
    --no-clipboard) CLIPBOARD=0; shift ;;
    -h | --help)
      sed -n '2,7p' "$0"
      exit 0
      ;;
    *)
      echo "dori-shot: unknown argument $1" >&2
      exit 1
      ;;
  esac
done

# With the cable in and Wi-Fi on at the same time, adb sees two devices and
# every bare adb call fails with "more than one device". Always name one, and
# prefer the cable: it is the faster transport and the one just plugged in.
dori_serial() {
  [[ -n ${DORI_SERIAL:-} ]] && { echo "$DORI_SERIAL"; return 0; }
  adb devices 2>/dev/null | awk '
    NR > 1 && $2 == "device" {
      if ($1 !~ /:/) { print $1; found = 1; exit }
      if (!wireless) wireless = $1
    }
    END { if (!found && wireless) print wireless }'
}

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@"; }

SERIAL=$(dori_serial)
if [[ -z $SERIAL ]]; then
  notify -u critical "Dori" "No phone over adb."
  echo "dori-shot: no adb device in state 'device'" >&2
  exit 1
fi

mkdir -p "$DIR"
out="$DIR/phone-$(date +%Y%m%d-%H%M%S).png"

# exec-out keeps the PNG bytes intact; `adb shell screencap` mangles them on
# some devices by translating line endings.
# Over Wi-Fi with the screen off this can crawl; wait, but not forever.
if ! timeout 25 adb -s "$SERIAL" exec-out screencap -p >"$out" 2>/dev/null || [[ ! -s $out ]]; then
  rm -f "$out"
  notify -u critical "Dori" "The screenshot failed."
  echo "dori-shot: screencap produced nothing" >&2
  exit 1
fi

if ((CLIPBOARD)) && command -v wl-copy >/dev/null 2>&1; then
  wl-copy --type image/png <"$out"
  notify "Dori" "Screenshot copied to the clipboard and saved to $out"
else
  notify "Dori" "Screenshot saved to $out"
fi

echo "$out"
