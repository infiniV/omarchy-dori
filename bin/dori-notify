#!/bin/bash
# Relay the phone's notifications to this desktop.
#
#   dori-notify start | stop | toggle | status | once
#
#   --interval N   seconds between polls (default 4)
#
# There is no app to install on the phone and no account anywhere: adb already
# has permission to read the notification dump, so this reads it, notices what
# is new, and hands it to notify-send. Nothing is written down but a hash of
# what has already been shown, and that lives in $XDG_RUNTIME_DIR — the
# notification text itself is never stored.
#
# Ongoing notifications (music players, downloads, "app is running") are
# skipped: they re-post constantly and would never stop arriving.

set -uo pipefail

# shellcheck source=dori-lib.sh
. "$(dirname "$(readlink -f "$0")")/dori-lib.sh" || exit 1

INTERVAL=4
RUNDIR=$(dori_rundir) || exit 1
SEEN="$RUNDIR/notify-seen"
ACTION=""

while (($# > 0)); do
  case "$1" in
    --interval) INTERVAL="${2:-4}"; shift 2 ;;
    -h | --help)
      sed -n '2,17p' "$0"
      exit 0
      ;;
    -*)
      echo "dori-notify: unknown flag $1" >&2
      exit 1
      ;;
    *) ACTION="$1"; shift ;;
  esac
done
ACTION="${ACTION:-status}"

# The daemon is this same script, re-executed with a marker argument, as the
# dori-notify user unit. The unit name is how it is found again — not the
# marker, not the script name, no pid file in a shared directory to trust.
MARKER="__relay"
SELF="$(realpath "$0")"

# With the cable in and Wi-Fi on at the same time, adb sees two devices and
# every bare adb call fails with "more than one device". Always name one, and
# prefer the cable: it is the faster transport and the one just plugged in.
dori_serial() {
  [[ -n ${DORI_SERIAL:-} ]] && { echo "$DORI_SERIAL"; return 0; }
  adb devices 2>/dev/null | awk '
    NR > 1 && $2 == "device" {
      if ($1 !~ /:/) { print $1; found = 1; exit }
      if (!wireless) wireless = $1
    }
    END { if (!found && wireless) print wireless }'
}

relaying() { dori_unit_active notify; }

# Deliver one phone notification to the desktop. Not with notify-send: its
# arguments sit in /proc/<pid>/cmdline while it runs, world-readable, and the
# arguments here are the user's messages. This makes the same D-Bus call with
# the text fed over stdin, so the content never appears on any command line.
# The python program itself is static — only "the shape", never the words.
send_notification() { # $1 app, $2 title, $3 body — on stdin, NUL-separated
  printf '%s\0%s\0%s' "$1" "$2" "$3" | /usr/bin/python3 -c '
import sys, gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib
app, title, body = (sys.stdin.buffer.read().decode("utf-8", "replace").split("\0") + ["", "", ""])[:3]
Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
    "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
    "org.freedesktop.Notifications", "Notify",
    GLib.Variant("(susssasa{sv}i)", (app, 0, "", title, body, [], {}, -1)),
    None, Gio.DBusCallFlags.NONE, -1, None)
' 2>/dev/null && return 0
  # No usable python-gobject (dori-setup installs it; this is a bare fallback):
  # say that something arrived, without the content, rather than leak it.
  command -v notify-send >/dev/null 2>&1 && notify-send -a "$1" -- "$1" "New notification on the phone"
}

# A package name is not a name. Translate the ones people actually have, and
# fall back to the last readable segment for everything else.
app_name() {
  case "$1" in
    com.whatsapp*) echo "WhatsApp" ;;
    com.google.android.gm) echo "Gmail" ;;
    com.google.android.apps.messaging) echo "Messages" ;;
    com.google.android.apps.dynamite) echo "Google Chat" ;;
    com.google.android.youtube) echo "YouTube" ;;
    org.telegram.messenger*) echo "Telegram" ;;
    com.instagram.android) echo "Instagram" ;;
    com.facebook.orca) echo "Messenger" ;;
    com.facebook.katana) echo "Facebook" ;;
    com.twitter.android | com.x.android) echo "X" ;;
    com.linkedin.android) echo "LinkedIn" ;;
    com.slack) echo "Slack" ;;
    com.discord) echo "Discord" ;;
    com.spotify.music) echo "Spotify" ;;
    com.microsoft.teams*) echo "Teams" ;;
    com.samsung.android.messaging) echo "Messages" ;;
    com.android.dialer | com.samsung.android.dialer) echo "Phone" ;;
    com.google.android.calendar) echo "Calendar" ;;
    *)
      local last="${1##*.}"
      printf '%s' "$(tr '[:lower:]' '[:upper:]' <<<"${last:0:1}")${last:1}"
      ;;
  esac
}

# One line per notification: pkg <tab> title <tab> text.
#
# Ongoing ones (FLAG_ONGOING, 0x2) are dropped here. Group summaries are left
# in: they usually carry the readable version of the thing, and an identical
# child is collapsed later by the content hash.
read_notifications() {
  local serial
  serial=$(dori_serial)
  [[ -z $serial ]] && return 0
  adb -s "$serial" shell dumpsys notification --noredact 2>/dev/null | awk '
    function value(line,   open) {
      open = index(line, "(")
      if (!open) return ""
      line = substr(line, open + 1)
      sub(/\)[[:space:]]*$/, "", line)
      return line
    }
    function emit() {
      if (pkg != "" && (title != "" || text != "") && !ongoing)
        printf "%s\t%s\t%s\n", pkg, title, text
      pkg = ""; title = ""; text = ""; ongoing = 0
    }
    /^ *NotificationRecord\(/ {
      emit()
      if (match($0, /pkg=[^ ]+/)) pkg = substr($0, RSTART + 4, RLENGTH - 4)
      next
    }
    /^ *flags=0x/ {
      if (pkg != "" && !flagseen) {
        flags = strtonum(substr($0, index($0, "0x")))
        if (and(flags, 2)) ongoing = 1
        flagseen = 1
      }
      next
    }
    /^ *android\.title=/ { if (title == "") title = value($0); next }
    /^ *android\.text=/  { if (text  == "") text  = value($0); next }
    /^ *NotificationRecord/ { next }
    { if ($0 ~ /^ *uid=/) flagseen = 0 }
    END { emit() }
  '
}

show_new() { # $1: 1 to notify, 0 to prime silently
  local notify=$1 pkg title text hash fresh
  local -A shown=()
  fresh=$(mktemp "$RUNDIR/notify-seen.XXXXXX")
  while IFS=$'\t' read -r pkg title text; do
    [[ -z $pkg ]] && continue
    hash=$(printf '%s\037%s\037%s' "$pkg" "$title" "$text" | cksum | cut -d' ' -f1)
    echo "$hash" >>"$fresh"
    # A grouped notification appears twice in one dump, as the summary and as
    # its child. Same text, same hash, one desktop notification.
    [[ -n ${shown[$hash]:-} ]] && continue
    shown[$hash]=1
    if ((notify)) && ! grep -qxF "$hash" "$SEEN" 2>/dev/null; then
      send_notification "$(app_name "$pkg")" "${title:-$(app_name "$pkg")}" "$text"
    fi
  done < <(read_notifications)

  # Keep the hashes of what is still on the phone, so a notification that is
  # dismissed and later re-posted is announced again.
  mv "$fresh" "$SEEN"
}

case "$ACTION" in
  status)
    jq -n --argjson running "$(relaying && echo true || echo false)" '{relaying: $running}'
    ;;

  once) show_new 1 ;;

  stop)
    dori_unit_stop notify
    command -v notify-send >/dev/null 2>&1 && notify-send "Dori" "Notification relay off"
    exit 0
    ;;

  start)
    if relaying; then
      echo "dori-notify: already relaying" >&2
      exit 0
    fi
    dori_require_user_systemd || exit 1
    # Prime quietly, so turning the relay on does not replay everything that is
    # already sitting in the phone's shade.
    show_new 0
    dori_unit_start notify "$RUNDIR/notify.log" "Dori notification relay" \
      "$SELF" "$MARKER" --interval "$INTERVAL"
    sleep 0.4
    if ! relaying; then
      echo "dori-notify: the relay did not start; see $RUNDIR/notify.log" >&2
      exit 1
    fi
    command -v notify-send >/dev/null 2>&1 && notify-send "Dori" "Relaying phone notifications"
    ;;

  toggle)
    if relaying; then exec "$SELF" stop; else exec "$SELF" start --interval "$INTERVAL"; fi
    ;;

  "$MARKER")
    while true; do
      [[ -n "$(dori_serial)" ]] && show_new 1
      sleep "$INTERVAL"
    done
    ;;

  *)
    echo "Usage: dori-notify <start|stop|toggle|status|once> [--interval N]" >&2
    exit 1
    ;;
esac
