#!/bin/bash
# Mirror the phone's screen onto this machine with scrcpy, over USB adb.
#
#   dori-mirror start | toggle | focus | stop | restart
#
#   --codec h264|h265   video codec (default h264)
#   --bitrate 20M       video bitrate (default 20M)
#   --fps 60            frame rate cap (default 60)
#   --max-size 0        longest edge, 0 for native (default 0)
#   --screen-off        blank the phone's own display while mirroring
#   --no-screen-off     leave it on (default)
#   --no-audio          do not forward phone audio
#
# The flags win over the PM_* environment variables, so the Dori panel can
# pass settings without touching the environment.

set -uo pipefail

TITLE="Dori Mirror"
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/dori"
mkdir -p "$RUNDIR"
LOG="$RUNDIR/mirror.log"

CODEC="${PM_CODEC:-h264}"
BITRATE="${PM_BITRATE:-20M}"
FPS="${PM_FPS:-60}"
MAXSIZE="${PM_MAXSIZE:-0}"
SCREEN_OFF="${PM_SCREEN_OFF:-}"
AUDIO=1
ACTION=""

while (($# > 0)); do
  case "$1" in
    --codec) CODEC="${2:-h264}"; shift 2 ;;
    --bitrate) BITRATE="${2:-20M}"; shift 2 ;;
    --fps) FPS="${2:-60}"; shift 2 ;;
    --max-size) MAXSIZE="${2:-0}"; shift 2 ;;
    --screen-off) SCREEN_OFF=1; shift ;;
    --no-screen-off) SCREEN_OFF=""; shift ;;
    --no-audio) AUDIO=0; shift ;;
    -h | --help)
      sed -n '2,17p' "$0"
      exit 0
      ;;
    -*)
      echo "dori-mirror: unknown flag $1" >&2
      exit 1
      ;;
    *) ACTION="$1"; shift ;;
  esac
done
ACTION="${ACTION:-toggle}"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@"; }

# Find processes by their actual executable name, then filter on an argument
# substring. `pgrep -f` alone matches anything that merely mentions the string
# — an editor with the script open, or the shell that launched this — and that
# is the difference between "the camera is live" and "someone opened a file".
proc_pids() { # $1 executable name, $2 argument substring
  pgrep -a -x "$1" 2>/dev/null | awk -v m="$2" 'index($0, m) { print $1 }'
}

proc_args() { # $1 executable name, $2 argument substring
  pgrep -a -x "$1" 2>/dev/null | awk -v m="$2" 'index($0, m) { print; exit }'
}

proc_kill() { # $1 executable name, $2 argument substring
  local pids
  pids=$(proc_pids "$1" "$2")
  [[ -n $pids ]] && kill $pids 2>/dev/null
  return 0
}

running_pid() {
  proc_pids scrcpy "--window-title=$TITLE" | head -1
}

stop_mirror() {
  proc_kill scrcpy "--window-title=$TITLE"
}

focus_mirror() {
  hyprctl dispatch focuswindow "title:^${TITLE}$" >/dev/null 2>&1
}

# Ask the phone which encoders it actually has, rather than pinning a vendor
# name that only exists on one chipset. scrcpy marks the hardware ones (hw);
# a phone with none is fine, and scrcpy picks its own default.
pick_encoder() {
  local codec=$1 serial cache
  serial=$(adb get-serialno 2>/dev/null | tr -cd '[:alnum:]._-')
  [[ -z $serial ]] && return 0
  cache="$RUNDIR/encoder-$serial-$codec"

  if [[ ! -f $cache ]]; then
    scrcpy --list-encoders 2>&1 |
      grep -F -- "--video-codec=$codec " |
      grep -F -- '(hw)' |
      grep -oP -- '--video-encoder=\K[^ ]+' |
      head -1 >"$cache"
  fi
  cat "$cache"
}

start_mirror() {
  if [[ "$(adb get-state 2>/dev/null)" != "device" ]]; then
    notify -u critical "Dori" "No phone over adb. Connect USB and accept the debugging prompt."
    echo "dori-mirror: no adb device in state 'device'" >&2
    exit 1
  fi

  local enc=() scroff=() audio=() encoder
  encoder=$(pick_encoder "$CODEC")
  [[ -n $encoder ]] && enc=(--video-encoder="$encoder")
  [[ -n $SCREEN_OFF ]] && scroff=(--turn-screen-off)
  ((AUDIO)) && audio=(--audio-codec=opus --audio-bit-rate=128K) || audio=(--no-audio)

  nohup scrcpy \
    --window-title="$TITLE" \
    --video-codec="$CODEC" "${enc[@]}" \
    --video-bit-rate="$BITRATE" \
    --max-fps="$FPS" \
    --max-size="$MAXSIZE" \
    "${audio[@]}" \
    --keyboard=uhid \
    --stay-awake \
    --power-off-on-close \
    "${scroff[@]}" \
    >"$LOG" 2>&1 &
  disown

  # Wait for the window, so a caller that starts then focuses has something to
  # focus, and so a failure surfaces as "no window" rather than silence.
  local i
  for i in {1..24}; do
    hyprctl clients -j 2>/dev/null |
      jq -e --arg t "$TITLE" 'any(.[]; .title == $t)' >/dev/null 2>&1 && return 0
    sleep 0.25
  done

  notify -u critical "Dori" "The mirror did not open. See $LOG"
  echo "dori-mirror: no window after 6s; see $LOG" >&2
  exit 1
}

case "$ACTION" in
  stop)
    if [[ -n "$(running_pid)" ]]; then
      stop_mirror
      notify "Dori" "Mirror stopped"
    fi
    ;;
  focus)
    # A no-op when nothing is mirroring, not a failure: the panel calls this
    # on a button that may race with the mirror exiting.
    [[ -n "$(running_pid)" ]] && focus_mirror
    exit 0
    ;;
  restart)
    stop_mirror
    sleep 0.5
    start_mirror
    ;;
  start | toggle)
    if [[ -n "$(running_pid)" ]]; then focus_mirror; else start_mirror; fi
    ;;
  *)
    echo "Usage: dori-mirror <start|toggle|focus|stop|restart> [flags]" >&2
    exit 1
    ;;
esac
