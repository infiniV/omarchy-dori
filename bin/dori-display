#!/bin/bash
# Turn the phone into a second display for this machine: a headless Hyprland
# output that a VNC app on the phone connects to over the network.
#
#   dori-display on | off | toggle | status
#
#   --size WxH   headless resolution (default: the attached phone's own screen,
#                in landscape)
#   --port N     VNC port (default 5900)
#
# The screen is served on a private address — the Tailscale one if Tailscale is
# up, otherwise this machine's LAN address. It is never bound to 0.0.0.0, and
# wayvnc has no password, so anyone already on that network can connect. Leave
# it off on networks you do not trust.

set -uo pipefail

SIZE=""
PORT=5900
RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/dori"
mkdir -p "$RUNDIR"
LOG="$RUNDIR/display.log"
QR="$RUNDIR/display-qr.png"
ACTION=""

while (($# > 0)); do
  case "$1" in
    --size) SIZE="${2:-2400x1080}"; shift 2 ;;
    --port) PORT="${2:-5900}"; shift 2 ;;
    -h | --help)
      sed -n '2,15p' "$0"
      exit 0
      ;;
    -*)
      echo "dori-display: unknown flag $1" >&2
      exit 1
      ;;
    *) ACTION="$1"; shift ;;
  esac
done
ACTION="${ACTION:-toggle}"

# With a phone attached, make the screen exactly its shape in landscape, so the
# VNC client fills the display instead of letterboxing it. Without one, assume a
# common phone and let the client scale.
dori_serial() {
  [[ -n ${DORI_SERIAL:-} ]] && { echo "$DORI_SERIAL"; return 0; }
  adb devices 2>/dev/null | awk '
    NR > 1 && $2 == "device" {
      if ($1 !~ /:/) { print $1; found = 1; exit }
      if (!wireless) wireless = $1
    }
    END { if (!found && wireless) print wireless }'
}

phone_size() {
  local serial wh w h
  serial=$(dori_serial)
  [[ -z $serial ]] && return 1
  wh=$(adb -s "$serial" shell wm size 2>/dev/null | sed -n 's/.*: *\([0-9]*x[0-9]*\).*/\1/p' | tail -1)
  [[ $wh =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  w="${BASH_REMATCH[1]}"; h="${BASH_REMATCH[2]}"
  # Landscape, and never larger than the phone can usefully draw.
  ((h > w)) && { local t=$w; w=$h; h=$t; }
  ((w > 2560)) && { h=$((h * 2560 / w)); w=2560; }
  echo "${w}x${h}"
}

if [[ -z $SIZE ]]; then
  SIZE=$(phone_size) || SIZE="2340x1080"
fi

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@"; }

# Find processes by their actual executable name, then filter on an argument
# substring. `pgrep -f` alone matches anything that merely mentions the string
# — an editor with the script open, or the shell that launched this — and that
# is the difference between "the camera is live" and "someone opened a file".
proc_pids() { # $1 executable name, $2 argument substring
  pgrep -a -x "$1" 2>/dev/null | awk -v m="$2" 'index($0, m) { print $1 }'
}

proc_args() { # $1 executable name, $2 argument substring
  pgrep -a -x "$1" 2>/dev/null | awk -v m="$2" 'index($0, m) { print; exit }'
}

proc_kill() { # $1 executable name, $2 argument substring
  local pids
  pids=$(proc_pids "$1" "$2")
  [[ -n $pids ]] && kill $pids 2>/dev/null
  return 0
}

headless_output() {
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | startswith("HEADLESS")) | .name' | head -1
}

# A private address the phone can actually reach. Tailscale first because it
# works from anywhere and is already authenticated; the LAN address second.
# Never 0.0.0.0 — that would put the desktop on every network at once.
serve_address() {
  local ip
  ip=$(tailscale ip -4 2>/dev/null | head -1)
  [[ -n $ip ]] && { echo "$ip"; return 0; }
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
  [[ -n $ip ]] && { echo "$ip"; return 0; }
  return 1
}

# Omarchy Quattro configures Hyprland in Lua, where `hyprctl keyword` is
# refused outright. Ask Lua first and keep the keyword call as the fallback for
# an older, non-Lua config.
set_mode() { # $1 output, $2 WxH, $3 xPos
  local out=$1 size=$2 x=$3
  if hyprctl eval "hl.monitor({ output = \"$out\", mode = \"$size@60\", position = \"${x}x0\", scale = 1 })" 2>/dev/null | grep -q '^ok'; then
    return 0
  fi
  hyprctl keyword monitor "$out, $size@60, ${x}x0, 1" >/dev/null 2>&1
}

# wayvnc can be installed and still not run — an AUR build left behind by a
# library upgrade fails at exec time, not at `command -v`. Ask it for its
# version and believe the answer.
vnc_ready() {
  command -v wayvnc >/dev/null 2>&1 && wayvnc --version >/dev/null 2>&1
}

status_json() {
  local out addr running=false url="" ready=false
  out=$(headless_output)
  vnc_ready && ready=true
  [[ -n "$(proc_pids wayvnc " $PORT")" ]] && running=true
  addr=$(serve_address)
  [[ $running == true && -n $addr ]] && url="vnc://$addr:$PORT"
  jq -n --arg output "${out:-}" --arg url "$url" --arg qr "$QR" \
    --argjson ready "$ready" \
    --argjson active "$([[ -n $out && $running == true ]] && echo true || echo false)" \
    '{active: $active,
      ready: $ready,
      output: (if $output == "" then null else $output end),
      url: (if $url == "" then null else $url end),
      qr: (if $url == "" then null else $qr end)}'
}

start_display() {
  local addr out edge created=false
  if ! vnc_ready; then
    notify -u critical "Dori" "wayvnc is not installed, or is installed and broken. See the README."
    echo "dori-display: wayvnc is missing or will not run (try: sudo pacman -S wayvnc)" >&2
    exit 1
  fi
  if ! addr=$(serve_address); then
    notify -u critical "Dori" "No network address to serve the screen on."
    echo "dori-display: no tailscale or LAN address" >&2
    exit 1
  fi

  out=$(headless_output)
  if [[ -z $out ]]; then
    created=true
    hyprctl output create headless >/dev/null
    local i
    for i in {1..8}; do
      out=$(headless_output)
      [[ -n $out ]] && break
      sleep 0.4
    done
  fi
  if [[ -z $out ]]; then
    notify -u critical "Dori" "Hyprland did not create a headless output."
    exit 1
  fi

  # Place it to the right of everything else, so windows dragged off the right
  # edge land on the phone.
  edge=$(hyprctl monitors -j | jq -r --arg o "$out" \
    '[.[] | select(.name != $o) | (.x + ((.width / .scale) | floor))] | max // 0')
  set_mode "$out" "$SIZE" "$edge"

  proc_kill wayvnc " $PORT"
  rm -f "${XDG_RUNTIME_DIR:-/tmp}/wayvncctl"
  sleep 0.2
  nohup wayvnc --output="$out" "$addr" "$PORT" >"$LOG" 2>&1 &
  disown
  sleep 0.6

  if [[ -z "$(proc_pids wayvnc " $PORT")" ]]; then
    # Do not leave a headless screen behind that nothing is serving.
    [[ $created == true ]] && hyprctl output remove "$out" >/dev/null 2>&1
    notify -u critical "Dori" "wayvnc did not start. See $LOG"
    echo "dori-display: wayvnc failed; see $LOG" >&2
    exit 1
  fi

  qrencode -o "$QR" -s 8 -m 2 "vnc://$addr:$PORT" 2>/dev/null
  notify "Dori" "Second screen live at vnc://$addr:$PORT"
  echo "vnc://$addr:$PORT"
}

stop_display() {
  local out
  proc_kill wayvnc " $PORT"
  out=$(headless_output)
  # Hyprland moves the workspaces back by itself when the output goes away.
  [[ -n $out ]] && hyprctl output remove "$out" >/dev/null
  rm -f "$QR"
  notify "Dori" "Second screen off"
}

case "$ACTION" in
  status) status_json ;;
  on) start_display ;;
  off) stop_display ;;
  toggle)
    if [[ "$(status_json | jq -r .active)" == "true" ]]; then stop_display; else start_display; fi
    ;;
  *)
    echo "Usage: dori-display <on|off|toggle|status> [--size WxH] [--port N]" >&2
    exit 1
    ;;
esac
