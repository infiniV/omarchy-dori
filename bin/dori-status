#!/bin/bash
# One JSON blob describing the attached phone and everything Dori is doing with
# it. The panel polls this; it is also readable on its own, which is how you
# debug a phone that will not cooperate without the shell in the way.
#
#   dori-status [--device /dev/video10] [--full]
#
# --full adds the battery, which costs an extra adb round trip. The panel asks
# for it only while it is open.
#
# Everything is best-effort: a field that cannot be determined comes back as
# null or false rather than absent, so the panel never has to guess a shape.

set -uo pipefail

# shellcheck source=dori-lib.sh
. "$(dirname "$(readlink -f "$0")")/dori-lib.sh" || exit 1

DEVICE="${DORI_V4L2_DEVICE:-/dev/video10}"
RUNDIR=$(dori_rundir) || exit 1
FULL=0

while (($# > 0)); do
  case "$1" in
    --device) DEVICE="${2:-}"; shift 2 ;;
    --full) FULL=1; shift ;;
    -h | --help)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    *)
      echo "dori-status: unknown argument $1" >&2
      exit 1
      ;;
  esac
done

# The first device adb lists, including the unusable ones: "unauthorized" is the
# single most common reason nothing works, and it deserves to be said out loud
# rather than looking like "absent". A cabled phone wins over a wireless one,
# because that is the one the user just plugged in.
adb_line=$(adb devices 2>/dev/null | awk '
  NR > 1 && NF >= 2 {
    if ($1 !~ /:/) { print $1, $2; found = 1; exit }
    if (!wireless) wireless = $1 " " $2
  }
  END { if (!found && wireless) print wireless }')
serial=$(awk '{print $1}' <<<"$adb_line")
state=$(awk '{print $2}' <<<"$adb_line")
[[ -z $state ]] && state="absent"
[[ $serial == *:* ]] && transport="wireless" || transport="usb"
[[ $state == "absent" ]] && transport=""

# The model and the Android version never change while a phone is attached, so
# ask once per serial and read the answer from then on.
model=""
android=""
if [[ $state == "device" && -n $serial ]]; then
  cache="$RUNDIR/props-${serial//[^A-Za-z0-9._-]/_}"
  if [[ ! -s $cache ]]; then
    {
      adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r'
      adb -s "$serial" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r'
    } >"$cache"
  fi
  model=$(sed -n 1p "$cache")
  android=$(sed -n 2p "$cache")
fi
[[ -z $model ]] && model="$serial"

# The battery costs a round trip, and over Wi-Fi that round trip is the slowest
# thing in the poll. It moves by a percent every few minutes; read it every
# twenty seconds and serve the cache in between.
battery_json="null"
battery_cache="$RUNDIR/battery-${serial//[^A-Za-z0-9._-]/_}"
if ((FULL)) && [[ $state == "device" && -n $serial ]] &&
  [[ -s $battery_cache ]] && (($(date +%s) - $(stat -c %Y "$battery_cache") < 20)); then
  battery_json=$(cat "$battery_cache")
elif ((FULL)) && [[ $state == "device" && -n $serial ]]; then
  dump=$(adb -s "$serial" shell dumpsys battery 2>/dev/null | tr -d '\r')
  level=$(sed -n 's/^ *level: *//p' <<<"$dump" | head -1)
  bstate=$(sed -n 's/^ *status: *//p' <<<"$dump" | head -1)
  if [[ -n $level ]]; then
    # BatteryManager: 2 is charging, 5 is full.
    charging=false
    [[ $bstate == "2" || $bstate == "5" ]] && charging=true
    battery_json=$(jq -n --argjson level "$level" --argjson charging "$charging" \
      '{level: $level, charging: $charging}')
    printf '%s' "$battery_json" >"$battery_cache"
  fi
fi

# Which camera the running scrcpy is sinking into the loopback node, if any.
camera_id=$(dori_unit_description camera | grep -oP -- 'camera \K\d+' | head -1)

# A loopback node that does not exist means v4l2loopback was never loaded.
loopback=false
[[ -c $DEVICE ]] && loopback=true

card=""
if [[ $loopback == true ]] && command -v v4l2-ctl >/dev/null 2>&1; then
  card=$(v4l2-ctl --device="$DEVICE" --info 2>/dev/null |
    sed -n 's/^[[:space:]]*Card type[[:space:]]*:[[:space:]]*//p' | head -1)
fi

mirroring=false
dori_unit_active mirror && mirroring=true

# The notification relay is this project's own daemon, found the same way.
relaying=false
dori_unit_active notify && relaying=true

# Only the recording Dori started. Another scrcpy writing an mp4 on this login
# is someone else's, and reporting it here would put a stop button in front of
# a recording this plugin has no business ending.
recording_file=$(dori_unit_description record)
recording_file=${recording_file#Dori recording to }

jq -n \
  --arg state "$state" \
  --arg serial "${serial:-}" \
  --arg model "$model" \
  --arg android "$android" \
  --arg transport "$transport" \
  --arg cameraId "${camera_id:-}" \
  --arg device "$DEVICE" \
  --arg card "$card" \
  --arg recording "${recording_file:-}" \
  --argjson battery "$battery_json" \
  --argjson relaying "$relaying" \
  --argjson loopback "$loopback" \
  --argjson mirroring "$mirroring" \
  '{
    state: $state,
    serial: (if $serial == "" then null else $serial end),
    model: (if $model == "" then null else $model end),
    android: (if $android == "" then null else $android end),
    transport: (if $transport == "" then null else $transport end),
    ready: ($state == "device"),
    battery: $battery,
    cameraId: (if $cameraId == "" then null else ($cameraId | tonumber) end),
    device: $device,
    card: (if $card == "" then null else $card end),
    loopback: $loopback,
    mirroring: $mirroring,
    relaying: $relaying,
    recording: ($recording != ""),
    recordingFile: (if $recording == "" then null else $recording end)
  }'
