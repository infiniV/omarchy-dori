#!/bin/bash
# One JSON blob describing the attached phone, the camera stream, and the
# screen mirror. The Dori panel polls this; it is also readable on its own,
# which is how you debug a phone that will not cooperate without the shell in
# the way.
#
# Everything is best-effort: a field that cannot be determined comes back as
# null or false rather than absent, so the panel never has to guess a shape.
#
#   dori-status [--device /dev/video10]

set -uo pipefail

DEVICE="${DORI_V4L2_DEVICE:-/dev/video10}"
TITLE="Dori Mirror"

while (($# > 0)); do
  case "$1" in
    --device)
      DEVICE="${2:-}"
      shift 2
      ;;
    -h | --help)
      sed -n '2,10p' "$0"
      exit 0
      ;;
    *)
      echo "dori-status: unknown argument $1" >&2
      exit 1
      ;;
  esac
done

# adb state for the first device listed, including the unusable ones.
# "unauthorized" is the single most common reason nothing works, and it
# deserves to be said out loud rather than looking like "absent".
adb_line=$(adb devices 2>/dev/null | awk 'NR > 1 && NF >= 2 {print $1, $2; exit}')
serial=$(awk '{print $1}' <<<"$adb_line")
state=$(awk '{print $2}' <<<"$adb_line")
[[ -z $state ]] && state="absent"

model=""
if [[ $state == "device" && -n $serial ]]; then
  model=$(adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
fi
[[ -z $model ]] && model="$serial"

# Which camera the running scrcpy is sinking to v4l2, if any.
camera_id=$(pgrep -af -- "scrcpy.*--v4l2-sink=$DEVICE" 2>/dev/null |
  grep -oP -- '--camera-id=\K\d+' | head -1)

# A loopback node that does not exist means v4l2loopback was never loaded.
loopback=false
[[ -c $DEVICE ]] && loopback=true

card=""
if [[ $loopback == true ]] && command -v v4l2-ctl >/dev/null 2>&1; then
  card=$(v4l2-ctl --device="$DEVICE" --info 2>/dev/null |
    sed -n 's/^[[:space:]]*Card type[[:space:]]*:[[:space:]]*//p' | head -1)
fi

mirroring=false
pgrep -f -- "scrcpy.*--window-title=$TITLE" >/dev/null 2>&1 && mirroring=true

jq -n \
  --arg state "$state" \
  --arg serial "${serial:-}" \
  --arg model "$model" \
  --arg cameraId "${camera_id:-}" \
  --arg device "$DEVICE" \
  --arg card "$card" \
  --argjson loopback "$loopback" \
  --argjson mirroring "$mirroring" \
  '{
    state: $state,
    serial: (if $serial == "" then null else $serial end),
    model: (if $model == "" then null else $model end),
    ready: ($state == "device"),
    cameraId: (if $cameraId == "" then null else ($cameraId | tonumber) end),
    device: $device,
    card: (if $card == "" then null else $card end),
    loopback: $loopback,
    mirroring: $mirroring
  }'
